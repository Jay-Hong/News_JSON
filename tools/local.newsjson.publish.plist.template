<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaunchAgent template for tools/local_publish.py.

  Replace every __STATE_DIR__ with the absolute state directory (for example
  /Users/NAME/Library/Application Support/NewsJSON), save the result as
  ~/Library/LaunchAgents/local.newsjson.publish.plist, then load it with:

      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/local.newsjson.publish.plist

  Stop and remove it with:

      launchctl bootout gui/$(id -u)/local.newsjson.publish

  Times are local time (05:44, 10:44, 15:44, 20:44 KST). main.yml runs one hour
  after each of them as a fallback, and tools/freshness_gate.py lists the same
  four times.
  A run missed while the Mac slept starts once on wake; a run missed while it
  was powered off or logged out is skipped. caffeinate -i only holds off idle
  sleep while a run is in progress; closing the lid still suspends it, and a
  run that was suspended mid-crawl refuses to publish. No credentials belong
  in this file: git uses whatever credential helper the user already has
  configured for github.com.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.newsjson.publish</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/caffeinate</string>
        <string>-i</string>
        <string>__STATE_DIR__/venv/bin/python</string>
        <string>__STATE_DIR__/code/tools/local_publish.py</string>
        <string>--state-dir</string>
        <string>__STATE_DIR__</string>
        <string>run</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>5</integer><key>Minute</key><integer>44</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>44</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>44</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>44</integer></dict>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>ProcessType</key>
    <string>Background</string>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>__STATE_DIR__/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__STATE_DIR__/launchd.log</string>
</dict>
</plist>
